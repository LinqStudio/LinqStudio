@page "/editor"
@page "/editor/{QueryIdParam:guid}"
@page "/editor/new"

<PageTitle>@SharedResource.Editor_Title</PageTitle>

<div class="editor-page pa-2" style="height:100%; display:flex; flex-direction:column; gap:8px" data-testid="editor-page">
	@if (Workspace.IsProjectOpen)
	{
		@if (Workspace.Queries.CurrentQueryId is not null)
		{
			<MudPaper Class="pa-1" Elevation="1" style="flex:1; min-height:0; display:flex; flex-direction:column;">
				<MudTabs Rounded="true"
						 ApplyEffectsToContainer="true"
						 KeepPanelsAlive="true"
						 ActivePanelIndex="@GetActivePanelIndex()"
						 ActivePanelIndexChanged="@OnActivePanelIndexChanged" data-testid="editor-query-tabs">
					@foreach (var q in GetOpenQueriesInOrder())
					{
						var capturedQ = q;
						<MudTabPanel @key="capturedQ.Id" Text="@GetTabName(capturedQ)">
							<QueryEditorPanel QueryId="capturedQ.Id"
											  Compiler="_compiler"
											  IsRefreshingSchema="@_isRefreshingSchema"
											  OnRefreshSchemaRequested="RefreshSchemaAsync"
											  OnQueryClosed="OnQueryClosedAsync"
											  @ref="_tabPanelRefs[capturedQ.Id]" />
						</MudTabPanel>
					}
				</MudTabs>
			</MudPaper>
		}
		else
		{
			<!-- No queries open -->
			<MudAlert Severity="Severity.Info" data-testid="no-query-alert">
				@SharedResource.Editor_NoQueryAlert
			</MudAlert>
		}

		<!-- Editor Info -->
		<MudPaper Class="pa-2" Elevation="1" data-testid="editor-info-bar">
			<MudText Typo="Typo.body2" Color="Color.Secondary">
				@SharedResource.Editor_Info_IntelliSense
			</MudText>
		</MudPaper>
	}
	else
	{
		<MudAlert Severity="Severity.Info" data-testid="no-project-alert">
			@SharedResource.Editor_NoProjectAlert
		</MudAlert>
	}
</div>
