@inherits LayoutComponentBase;
@implements IDisposable
@inject IOptionsMonitor<UISettings> UISettings;
@inject ISettingsService SettingsService;
@inject ErrorHandlingService ErrorHandlingService;
@inject ProjectWorkspace Workspace;

<MudThemeProvider Theme="@_theme" IsDarkMode="UISettings.CurrentValue.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="linqstudio-shell" data-testid="app-shell">
    <MudAppBar Class="linqstudio-appbar" Elevation="1" data-testid="shell-topbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@DrawerToggle"
                       aria-label="@SharedResource.Shell_Navigation_Toggle" />
        <MudText Typo="Typo.h5" Class="linqstudio-brand">LinqStudio</MudText>

        <div class="linqstudio-identity" data-testid="shell-connection-identity">
            <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Class="linqstudio-identity-label">
                    @SharedResource.Shell_Connection_Label
                </MudText>
                <MudText Typo="Typo.body2" Class="linqstudio-identity-value">
                    @GetConnectionIdentity()
                </MudText>
            </MudStack>
            @if (Workspace.HasUnsavedChanges)
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Color="Color.Warning"
                         Icon="@Icons.Material.Filled.Edit"
                         Label="true">
                    @SharedResource.Shell_Status_Unsaved
                </MudChip>
            }
        </div>

        <MudSpacer />

        <MudTooltip Text="@SharedResource.AppBar_Button_Settings">
            <MudIconButton Href="/settings"
                           Icon="@Icons.Material.Filled.Settings"
                           Color="Color.Inherit"
                           aria-label="@SharedResource.AppBar_Button_Settings" />
        </MudTooltip>

        <MudTooltip Text="@SharedResource.Shell_Button_ToggleTheme">
            <MudIconButton Icon="@(DarkLightModeButtonIcon)"
                           Color="Color.Inherit"
                           OnClick="@DarkModeToggle"
                           aria-label="@SharedResource.Shell_Button_ToggleTheme" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer id="nav-drawer"
               @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Class="linqstudio-object-explorer"
               data-testid="object-explorer-zone">
        <div class="linqstudio-drawer-content">
            <section class="linqstudio-navigation-zone" data-testid="navigation-zone">
                <MudText Typo="Typo.overline" Class="linqstudio-zone-label">
                    @SharedResource.Shell_Navigation_Label
                </MudText>
                <NavMenu />
            </section>
            <section class="linqstudio-explorer-zone" data-testid="explorer-zone">
                <DatabaseTreeView />
            </section>
        </div>
    </MudDrawer>

    <MudMainContent Class="mainBody linqstudio-main-content pt-16 pa-4">
        <section class="linqstudio-workspace-zone" data-testid="workspace-zone">
            <AppErrorBoundary>
                @Body
            </AppErrorBoundary>
        </section>
    </MudMainContent>

    <footer class="linqstudio-status-zone" data-testid="status-zone">
        <MudIcon Icon="@GetStatusIcon()" Size="Size.Small" />
        <MudText Typo="Typo.caption">@GetWorkspaceStatus()</MudText>
        <MudSpacer />
        @if (Workspace.IsProjectOpen)
        {
            <MudText Typo="Typo.caption" Class="linqstudio-status-connection">
                @Workspace.CurrentProject?.DatabaseType
            </MudText>
        }
    </footer>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private MudTheme? _theme = null;
    private IDisposable? _SettingsDisposable;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };

        _SettingsDisposable = UISettings.OnChange(_ => InvokeAsync(StateHasChanged));
        Workspace.WorkspaceChanged += OnWorkspaceChanged;
    }

    public void Dispose()
    {
        _SettingsDisposable?.Dispose();
        Workspace.WorkspaceChanged -= OnWorkspaceChanged;
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void OnWorkspaceChanged(object? sender, EventArgs e)
        => InvokeAsync(StateHasChanged);

    private string GetConnectionIdentity()
        => Workspace.IsProjectOpen
            ? $"{Workspace.CurrentProjectName} · {Workspace.CurrentProject?.DatabaseType}"
            : SharedResource.Shell_Connection_None;

    private string GetWorkspaceStatus()
        => !Workspace.IsProjectOpen
            ? SharedResource.Shell_Status_NoProject
            : Workspace.HasUnsavedChanges
                ? SharedResource.Shell_Status_Unsaved
                : SharedResource.Shell_Status_Ready;

    private string GetStatusIcon()
        => !Workspace.IsProjectOpen
            ? Icons.Material.Filled.Info
            : Workspace.HasUnsavedChanges
                ? Icons.Material.Filled.Edit
                : Icons.Material.Filled.CheckCircle;

    private async Task DarkModeToggle()
    {
        var newSettings = UISettings.CurrentValue with
        {
            IsDarkMode = !UISettings.CurrentValue.IsDarkMode
        };

        try
        {
            await SettingsService.Save(newSettings);
        }
        catch (Exception ex)
        {
            await ErrorHandlingService.HandleErrorAsync(ex, "Failed to update UI settings.");
        }
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#110e2d",
        AppbarText = "#424242",
        AppbarBackground = "rgba(255,255,255,0.8)",
        DrawerBackground = "#ffffff",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "#1a1a27",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };

    public string DarkLightModeButtonIcon => UISettings.CurrentValue.IsDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}
