@using LinqStudio.Abstractions.Models
@using LinqStudio.Blazor.Models
@using LinqStudio.Blazor.Services

@*
	Note: MudBlazor v8's MudTreeView.Items requires IReadOnlyCollection<TreeItemData<T>> which would
	require SchemaTreeNode to inherit TreeItemData<SchemaTreeNode>, adding unnecessary coupling between
	the view-model and the UI framework. We use ChildContent with explicit tree traversal instead,
	which keeps SchemaTreeNode as a pure view-model class and matches the existing component pattern.

	Note: MudMenu is NOT used for context menus here. MudMenu internally uses MudPopover, which
	requires <MudPopoverProvider /> to be present and triggers IAsyncDisposable-only services that
	break bUnit's synchronous test teardown. Instead, we use a native @oncontextmenu handler with a
	state-driven positioned div, which is fully bUnit-compatible and provides the same SSMS-style UX.
*@

@* Backdrop: closes the context menu when user clicks outside it *@
@if (_contextMenuNode != null)
{
	<div class="db-tree-context-backdrop"
		 @onclick="CloseContextMenu"
		 @oncontextmenu="CloseContextMenu"
		 @oncontextmenu:preventDefault="true" />
	<div class="db-tree-context-menu" style="@ContextMenuStyle">
		@if (_contextMenuNode.NodeType == SchemaTreeNodeType.TablesFolder)
		{
			<div class="db-tree-context-item"
				 @onclick="HandleTablesFolderRefreshAsync"
				 data-testid="db-tree-tables-folder-refresh">
				<MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="mr-2" />
				@SharedResource.DatabaseTreeView_ContextMenu_Refresh
			</div>
		}
		else if (_contextMenuNode.NodeType == SchemaTreeNodeType.Table)
		{
			<div class="db-tree-context-item"
				 @onclick="@(async () => await HandleTableSelectTop1000Async(_contextMenuNode))"
				 data-testid="@($"db-tree-table-select-top-1000-{_contextMenuNode.TableName?.FullName}")">
				<MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Class="mr-2" />
				@SharedResource.DatabaseTreeView_ContextMenu_SelectTop1000
			</div>
			<div class="db-tree-context-item"
				 @onclick="@(async () => await HandleTableRefreshAsync(_contextMenuNode))"
				 data-testid="@($"db-tree-table-refresh-{_contextMenuNode.TableName?.FullName}")">
				<MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="mr-2" />
				@SharedResource.DatabaseTreeView_ContextMenu_Refresh
			</div>
		}
		else if (_contextMenuNode.NodeType == SchemaTreeNodeType.Connection)
		{
			<div class="db-tree-context-item"
				 @onclick="OpenCustomRelationshipsAsync"
				 data-testid="db-tree-connection-custom-relationships">
				<MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Class="mr-2" />
				@SharedResource.CustomRelationships_ContextMenu
			</div>
			<div class="db-tree-context-item"
				 @onclick="HandleConnectionNewQuery"
				 data-testid="db-tree-connection-new-query">
				<MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mr-2" />
				@SharedResource.DatabaseTreeView_ContextMenu_NewQuery
			</div>
		}
	</div>
}

<div class="database-explorer" data-testid="database-explorer">
	<div class="database-explorer-header">
		<div class="d-flex align-center">
			<MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" Size="Size.Small" />
			<MudText Typo="Typo.subtitle2">@SharedResource.Shell_Explorer_Title</MudText>
		</div>
		@if (Workspace.IsProjectOpen && Workspace.CurrentProject?.QueryGenerator != null)
		{
			<MudText Typo="Typo.caption" Class="mud-text-secondary">
				@SharedResource.Shell_Explorer_Subtitle
			</MudText>
		}
	</div>

	@if (Workspace.IsProjectOpen && Workspace.CurrentProject?.QueryGenerator != null)
	{
		<div class="database-explorer-toolbar">
			<MudTextField T="string"
						  @bind-Value="_filterText"
						  Immediate="true"
						  Label="@SharedResource.DatabaseTreeView_SearchLabel"
						  Placeholder="@SharedResource.DatabaseTreeView_SearchPlaceholder"
						  Variant="Variant.Outlined"
						  Margin="Margin.Dense"
						  Adornment="Adornment.Start"
						  AdornmentIcon="@Icons.Material.Filled.Search"
						  Clearable="true"
						  data-testid="db-tree-search" />
			<MudIconButton Icon="@Icons.Material.Filled.Refresh"
						   Size="Size.Small"
						   Disabled="@_isLoading"
						   OnClick="RefreshTablesFolderAsync"
						   aria-label="@SharedResource.DatabaseTreeView_Refresh"
						   title="@SharedResource.DatabaseTreeView_Refresh"
						   data-testid="db-tree-refresh" />
		</div>

		@if (_isLoading)
		{
			<MudProgressLinear Indeterminate="true" Class="database-explorer-progress" data-testid="db-tree-loading" />
		}

		@if (_loadError != null)
		{
			<MudAlert Severity="Severity.Error" Dense="true" Class="database-explorer-error" data-testid="db-tree-error">
				<div class="d-flex align-center justify-space-between gap-2">
					<span>@_loadError</span>
					<MudButton Variant="Variant.Text"
							   Color="Color.Error"
							   Size="Size.Small"
							   OnClick="LoadTablesAsync"
							   data-testid="db-tree-retry">
						@SharedResource.DatabaseTreeView_Retry
					</MudButton>
				</div>
			</MudAlert>
		}

		@if (_rootNodes.Count > 0)
		{
			<div data-testid="db-tree-view">
				<MudTreeView T="SchemaTreeNode" Dense="true" Hover="true">
					@foreach (var connNode in _rootNodes)
					{
						<MudTreeViewItem T="SchemaTreeNode"
										 Value="@connNode"
										 Icon="@connNode.Icon"
										 IconColor="@connNode.IconColor"
										 @key="connNode"
										 Expanded="@connNode.IsExpanded"
										 ExpandedChanged="@(value => OnNodeExpandedChanged(connNode, value))"
										 data-testid="db-tree-connection">
							<BodyContent Context="_">
								<div @oncontextmenu="@(e => OpenContextMenu(connNode, e))"
									 @oncontextmenu:preventDefault="true"
									 @oncontextmenu:stopPropagation="true"
									 @onclick="() => SelectNode(connNode)"
									 class="@GetNodeClass(connNode)"
									 title="@connNode.Label"
									 data-testid="db-tree-connection-body">
									<MudText Typo="Typo.body1" Class="mud-treeview-item-label">@connNode.Label</MudText>
							</BodyContent>
							<ChildContent>
								@foreach (var databaseNode in GetVisibleDatabaseNodes())
								{
									<MudTreeViewItem T="SchemaTreeNode"
															 Value="@databaseNode"
															 Icon="@databaseNode.Icon"
															 IconColor="@databaseNode.IconColor"
															 @key="databaseNode"
															 Expanded="@databaseNode.IsExpanded"
															 ExpandedChanged="@(value => OnNodeExpandedChanged(databaseNode, value))"
															 data-testid="@($"db-tree-database-{databaseNode.DatabaseInfo?.Name}")">
												<BodyContent Context="_">
													<div @onclick="() => SelectNode(databaseNode)"
														 class="@GetNodeClass(databaseNode)"
														 title="@databaseNode.Label">
														<MudText Typo="Typo.body1" Class="mud-treeview-item-label">@databaseNode.Label</MudText>
													</div>
												</BodyContent>
										<ChildContent>
											@foreach (var tablesFolderNode in databaseNode.Children)
											{
												<MudTreeViewItem T="SchemaTreeNode"
																 Value="@tablesFolderNode"
																 Icon="@tablesFolderNode.Icon"
																 IconColor="@tablesFolderNode.IconColor"
																 @key="tablesFolderNode"
																 Expanded="@tablesFolderNode.IsExpanded"
																 ExpandedChanged="@(value => OnNodeExpandedChanged(tablesFolderNode, value))"
																 data-testid="db-tree-tables-folder"
																 data-database="@databaseNode.DatabaseInfo?.Name">
													<BodyContent Context="_">
														<div @oncontextmenu="@(e => OpenContextMenu(tablesFolderNode, e))"
															 @oncontextmenu:preventDefault="true"
															 @oncontextmenu:stopPropagation="true">
															<div @onclick="() => SelectNode(tablesFolderNode)"
																 class="@GetNodeClass(tablesFolderNode)"
																 title="@GetTablesFolderLabel(tablesFolderNode)">
																<MudText Typo="Typo.body1"
																		 Class="mud-treeview-item-label">@GetTablesFolderLabel(tablesFolderNode)</MudText>
															</div>
														</div>
													</BodyContent>
													<ChildContent>
														@foreach (var tableNode in GetVisibleTableNodes(databaseNode))
														{
														@* Table: right-click context menu + lazy-load columns *@
														<MudTreeViewItem T="SchemaTreeNode"
																		 Value="@tableNode"
																		 Icon="@tableNode.Icon"
																		 IconColor="@tableNode.IconColor"
																		 @key="tableNode"
																		 Expanded="@tableNode.IsExpanded"
																		 ExpandedChanged="@(async v => await OnTableExpandedChanged(tableNode, v))"
																		 data-testid="@($"table-{tableNode.TableName?.FullName}")">
															<BodyContent Context="_">
																<div @oncontextmenu="@(e => OpenContextMenu(tableNode, e))"
														 @oncontextmenu:preventDefault="true"
														 @oncontextmenu:stopPropagation="true"
														 @onclick="() => SelectNode(tableNode)"
														 class="@GetNodeClass(tableNode)"
														 title="@tableNode.Label"
														 data-testid="@($"db-tree-table-body-{tableNode.TableName?.FullName}")">
														<MudText Typo="Typo.body1"
																 Class="mud-treeview-item-label">@tableNode.Label</MudText>
													</div>
															</BodyContent>
															<ChildContent>
																@if (tableNode.IsLoading)
														{
																	<MudTreeViewItem T="SchemaTreeNode" Value="@_spinnerNode" CanExpand="false">
																		<Content>
																			<div class="d-flex align-center">
																				<MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
																				<MudText Typo="Typo.caption">@SharedResource.DatabaseTreeView_LoadingColumns</MudText>
																			</div>
																		</Content>
															</MudTreeViewItem>
														}
																else if (tableNode.LoadError != null)
																{
																	<MudText Typo="Typo.caption" Color="Color.Error" Class="database-explorer-node-error"
																			 data-testid="@($"db-tree-table-error-{tableNode.TableName?.FullName}")">
																		@tableNode.LoadError
																	</MudText>
																}
																else
																{
																	@foreach (var colNode in tableNode.Children)
																	{
																		<MudTreeViewItem T="SchemaTreeNode" Value="@colNode" CanExpand="false" @key="colNode"
																						 data-testid="@($"column-{tableNode.TableName?.FullName}-{colNode.ColumnDetail?.Name}")">
																			<Content>
																				<div @onclick="() => SelectNode(colNode)" class="@GetNodeClass(colNode)"
																						 title="@GetColumnTitle(colNode)"
																						 data-testid="@($"column-body-{tableNode.TableName?.FullName}-{colNode.ColumnDetail?.Name}")">
																					<MudIcon Icon="@colNode.Icon" Color="@colNode.IconColor" Size="Size.Small" Class="mr-1" />
																					<MudText Typo="Typo.body2">@colNode.Label</MudText>
																					@if (!string.IsNullOrEmpty(colNode.ColumnTypeDisplay))
																					{
																						<MudText Typo="Typo.caption" Class="mud-text-secondary ml-2">@colNode.ColumnTypeDisplay</MudText>
																					}
																				</div>
																			</Content>
																		</MudTreeViewItem>
																	}
																}
															</ChildContent>
														</MudTreeViewItem>
														}
													</ChildContent>
												</MudTreeViewItem>
											}
										</ChildContent>
									</MudTreeViewItem>
								}
							</ChildContent>
						</MudTreeViewItem>
					}
				</MudTreeView>
				@if (!_isLoading && !string.IsNullOrWhiteSpace(_filterText) && !GetVisibleTableNodes().Any())
				{
					<MudText Typo="Typo.caption"
							 Class="database-explorer-empty"
							 data-testid="db-tree-no-matches">
						@SharedResource.DatabaseTreeView_NoMatches
					</MudText>
				}
			</div>
		}
	}
	else
	{
		<MudText Typo="Typo.caption" Class="mud-text-secondary ml-2" data-testid="db-tree-placeholder">
			@SharedResource.DatabaseTreeView_Placeholder
		</MudText>
	}
</div>
