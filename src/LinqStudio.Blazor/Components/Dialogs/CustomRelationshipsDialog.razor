@using LinqStudio.Core.Models
@using LinqStudio.Abstractions.Models

<MudDialog Class="custom-relationships-dialog" data-testid="custom-relationships-dialog">
	<TitleContent>
		<MudText Typo="Typo.h6">@Text("CustomRelationships.Title", "Configure relationships")</MudText>
	</TitleContent>
	<DialogContent>
		@if (_isLoading)
		{
			<MudStack AlignItems="AlignItems.Center" Class="pa-6">
				<MudProgressCircular Indeterminate="true" data-testid="custom-relationships-loading" />
			</MudStack>
		}
		else
		{
			<MudTabs Rounded="true" KeepPanelsAlive="true" @bind-ActivePanelIndex="_activeTab">
				<MudTabPanel Text="@Text("CustomRelationships.Tab.DbContext", "DbContext")">
					<MudStack Spacing="2" Class="pa-2">
						<MudText Typo="Typo.body2">@Text("CustomRelationships.DbContext.Help", "Add code that will be placed in OnModelCreating. The preview shows the current final version.")</MudText>
						<MudTextField T="string"
									  @bind-Value="_onConfigureCode"
									  Label="@Text("CustomRelationships.DbContext.ManualCode", "Manual configuration code")"
									  Variant="Variant.Outlined"
									  Lines="8"
									  Immediate="true"
									  data-testid="custom-relationships-manual-code" />
						<MudText Typo="Typo.subtitle2">@Text("CustomRelationships.DbContext.FinalVersion", "Final version preview")</MudText>
						<MudTextField T="string"
									  Value="@FinalOnConfigureCode"
									  ReadOnly="true"
									  Variant="Variant.Outlined"
									  Lines="12"
									  data-testid="custom-relationships-final-code" />
					</MudStack>
				</MudTabPanel>
				<MudTabPanel Text="@Text("CustomRelationships.Tab.Models", "Models")">
					<MudGrid Spacing="2" Class="pa-2">
						<MudItem xs="12" sm="4">
							<MudText Typo="Typo.subtitle2">@Text("CustomRelationships.Models.Models", "Models")</MudText>
							<MudList T="DatabaseTableDetail" Dense="true" data-testid="custom-relationships-model-list">
								@foreach (var model in _tables)
								{
									<MudListItem T="DatabaseTableDetail"
												 @key="model.FullName"
												 OnClick="@(() => SelectModel(model))"
												 Class="custom-relationship-model"
												 Style="@GetModelItemStyle(model)"
												 data-testid="@($"custom-relationship-model-{model.FullName}")">
										<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
											@if (ReferenceEquals(_selectedModel, model))
											{
												<MudIcon Icon="@Icons.Material.Filled.RadioButtonChecked"
														 Color="Color.Primary"
														 Size="Size.Small" />
											}
											<MudText Color="@(ReferenceEquals(_selectedModel, model) ? Color.Primary : Color.Default)"
													 Typo="@(ReferenceEquals(_selectedModel, model) ? Typo.subtitle2 : Typo.body1)">
												@model.FullName
											</MudText>
										</MudStack>
									</MudListItem>
								}
							</MudList>
						</MudItem>
						<MudItem xs="12" sm="8">
							@if (_selectedModel is null)
							{
								<MudText Color="Color.Secondary">@Text("CustomRelationships.Models.SelectModel", "Select a model to configure its relationships.")</MudText>
							}
							else
							{
								<MudStack Spacing="2">
									<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="custom-relationship-selected-model">
										<MudText Typo="Typo.subtitle2">@Text("CustomRelationships.Models.Editing", "Editing model")</MudText>
										<MudText Typo="Typo.body1">@_selectedModel.FullName</MudText>
									</MudAlert>
									@if (_selectedRelationships.Count > 0)
									{
										<MudList T="CustomRelationship" Dense="true" data-testid="custom-relationship-list">
											@foreach (var relationship in _selectedRelationships)
											{
												<MudListItem T="CustomRelationship" @key="relationship.Id" OnClick="@(() => EditRelationship(relationship))">
													<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
														<MudText>@($"{relationship.PrincipalTable} → {relationship.DependentTable} ({relationship.Cardinality})")</MudText>
														<span @onclick:stopPropagation="true">
															<MudIconButton Icon="@Icons.Material.Filled.Delete"
																		   Color="Color.Error"
																		   Size="Size.Small"
																		   OnClick="@(() => RemoveRelationship(relationship))"
																		   data-testid="@($"custom-relationship-delete-{relationship.Id}")" />
														</span>
													</MudStack>
												</MudListItem>
											}
										</MudList>
									}
									<MudTooltip Text="@TextFormat("CustomRelationships.Form.LinkToTableTooltip", "Choose the table that {0} should link to.", GetModelName(_selectedModel.FullName))" Placement="Placement.Top">
									<MudSelect T="string" Value="_editRelationship.PrincipalTable" ValueChanged="PrincipalTableChanged" Label="@Text("CustomRelationships.Form.LinkToTable", "Link to table")" Variant="Variant.Outlined" Dense="true" data-testid="custom-relationship-principal-table">
										@foreach (var table in _tables)
										{
											<MudSelectItem T="string" Value="@table.FullName">@table.FullName</MudSelectItem>
										}
									</MudSelect>
									</MudTooltip>
									<MudTooltip Text="@GetCardinalityTooltip()" Placement="Placement.Top">
									<MudSelect T="RelationshipCardinality" @bind-Value="_editRelationship.Cardinality" Label="@Text("CustomRelationships.Form.Cardinality", "Cardinality")" Variant="Variant.Outlined" Dense="true" data-testid="custom-relationship-cardinality">
										@foreach (var cardinality in Enum.GetValues<RelationshipCardinality>())
										{
											<MudSelectItem T="RelationshipCardinality" Value="@cardinality">@cardinality</MudSelectItem>
										}
									</MudSelect>
									</MudTooltip>
									<MudTooltip Text="@TextFormat("CustomRelationships.Form.RequiredTooltip", "Turn this on when every {0} must be linked to a {1}.", GetModelName(_selectedModel.FullName), GetModelName(_editRelationship.PrincipalTable))" Placement="Placement.Top">
										<MudCheckBox @bind-Value="_editRelationship.IsRequired" Label="@TextFormat("CustomRelationships.Form.Required", "Each {0} must be linked to a {1}", GetModelName(_selectedModel.FullName), GetModelName(_editRelationship.PrincipalTable))" Color="Color.Primary" data-testid="custom-relationship-required" />
									</MudTooltip>
									<MudTooltip Text="@Text("CustomRelationships.Form.DeleteBehaviorTooltip", "Choose what happens to linked rows when the principal table row is deleted.")" Placement="Placement.Top">
									<MudSelect T="RelationshipDeleteBehavior" @bind-Value="_editRelationship.DeleteBehavior" Label="@Text("CustomRelationships.Form.DeleteBehavior", "Delete behavior")" Variant="Variant.Outlined" Dense="true">
										@foreach (var behavior in Enum.GetValues<RelationshipDeleteBehavior>())
										{
											<MudSelectItem T="RelationshipDeleteBehavior" Value="@behavior">@behavior</MudSelectItem>
										}
									</MudSelect>
									</MudTooltip>
									<MudText Typo="Typo.subtitle2">@Text("CustomRelationships.Form.KeyPairs", "Key pairs")</MudText>
									@foreach (var pair in _editRelationship.KeyPairs)
									{
										<div class="d-flex align-center ga-2" @key="pair">
											<MudTooltip Text="@TextFormat("CustomRelationships.Form.SelectedColumnTooltip", "Pick the column in {0} that contains the link.", GetModelName(_selectedModel.FullName))" Placement="Placement.Top">
											<MudSelect Class="key-pair-column-select" T="string" Value="@pair.DependentColumn" ValueChanged="@(value => DependentColumnChanged(pair, value))" Label="@TextFormat("CustomRelationships.Form.SelectedColumn", "Column in {0}", GetModelName(_selectedModel.FullName))" Variant="Variant.Outlined" Dense="true">
												@foreach (var column in _selectedModel.Columns.Select(x => x.Name))
												{
													<MudSelectItem T="string" Value="@column">@column</MudSelectItem>
												}
											</MudSelect>
											</MudTooltip>
											<MudTooltip Text="@TextFormat("CustomRelationships.Form.MatchingKeyTooltip", "Pick the matching key column in {0}.", GetModelName(_editRelationship.PrincipalTable))" Placement="Placement.Top">
											<MudSelect Class="key-pair-column-select" T="string" Value="@pair.PrincipalColumn" ValueChanged="@(value => PrincipalColumnChanged(pair, value))" Label="@TextFormat("CustomRelationships.Form.MatchingKey", "Matching key in {0}", GetModelName(_editRelationship.PrincipalTable))" Variant="Variant.Outlined" Dense="true">
												@foreach (var column in GetColumns(_editRelationship.PrincipalTable))
												{
													<MudSelectItem T="string" Value="@column">@column</MudSelectItem>
												}
											</MudSelect>
											</MudTooltip>
											<MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" Color="Color.Error" OnClick="@(() => _editRelationship.KeyPairs.Remove(pair))" />
										</div>
									}
									<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddKeyPair" data-testid="custom-relationship-add-key">
										@Text("CustomRelationships.Form.AddKeyPair", "Add key pair")
									</MudButton>
									<MudText Typo="Typo.subtitle2">@Text("CustomRelationships.Form.Navigation", "Navigation properties")</MudText>
									<MudTooltip Text="@GetPrincipalNavigationTooltip()" Placement="Placement.Top">
										<MudTextField T="string" @bind-Value="_editRelationship.PrincipalNavigation" Label="@Text("CustomRelationships.Form.PrincipalNavigation", "Principal navigation property")" Placeholder="@SuggestedPrincipalNavigation" Variant="Variant.Outlined" />
									</MudTooltip>
									<MudTooltip Text="@GetDependentNavigationTooltip()" Placement="Placement.Top">
										<MudTextField T="string" @bind-Value="_editRelationship.DependentNavigation" Label="@Text("CustomRelationships.Form.DependentNavigation", "Dependent navigation property")" Placeholder="@SuggestedDependentNavigation" Variant="Variant.Outlined" />
									</MudTooltip>
									<MudStack Row="true" Justify="Justify.FlexEnd">
										<MudButton Variant="Variant.Outlined" OnClick="StartNewRelationship" data-testid="custom-relationship-new">
											@Text("CustomRelationships.Form.New", "New relationship")
										</MudButton>
										<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveRelationship" data-testid="custom-relationship-save">
											@Text("CustomRelationships.Form.Save", "Save relationship")
										</MudButton>
									</MudStack>
								</MudStack>
							}
						</MudItem>
					</MudGrid>
				</MudTabPanel>
			</MudTabs>
		}
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel" data-testid="custom-relationships-cancel">@Text("CustomRelationships.Button.Cancel", "Cancel")</MudButton>
		<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_isLoading" data-testid="custom-relationships-save">
			@Text("CustomRelationships.Button.Save", "Save")
		</MudButton>
	</DialogActions>
</MudDialog>
